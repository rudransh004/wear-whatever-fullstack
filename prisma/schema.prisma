// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  images      String[] // Array of image URLs
  category    String
  isAiEnabled Boolean  @default(false) // To mark AI-generated shirts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wishlistedBy Wishlist[]
  reviews Review[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  
  // NEW: AI Chatbot Token System
  aiCredits Int      @default(10)    // Every new user gets 10 free messages
  isProUser Boolean  @default(false) // Set to true if they buy a subscription

  orders    Order[]
  wishlist  Wishlist[]
  reviews   Review[] 
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  customerEmail String
  address       String
  
  // NEW: Pricing Breakdown
  subtotal      Float       @default(0)// Sum of items before discount/shipping
  discount      Float       @default(0)
  deliveryFee   Float       @default(0)
  totalAmount   Float       // Final amount paid
  couponCode    String?     // Which coupon was used (if any)
  
  status        String      @default("Processing")
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId]) // 👈 Prevents duplicate wishlisting of the same item
}

// NEW MODEL
model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   // "PERCENTAGE" (e.g., 10%) or "FLAT" (e.g., ₹500)
  discountValue Float
  isActive      Boolean  @default(true)
  minCartValue  Float    @default(0) // e.g., Must spend ₹2000 to use this
  createdAt     DateTime @default(now())
}

// NEW MODEL: Verified Reviews
model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1 to 5 stars
  comment   String?  // Optional text review
  
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  // CRITICAL SECURITY: A user can only leave ONE review per product
  @@unique([userId, productId]) 
}