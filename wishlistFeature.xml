    margin-bottom: 1rem;
    display: inline-block;
    border: 1px solid currentColor;
    padding: 0.2rem 0.75rem;
    border-radius: 99px;
}

/* Section Mechanics */
section {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 100svh;
    overflow: hidden;
